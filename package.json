{
  "name": "@hatkom/lint-tools",
  "version": "1.3.0",
  "description": "Dead-code lint tools for NestJS + GraphQL monorepos: find unused GraphQL fields and unused service methods.",
  "author": "Max Schmide",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hatkom-io/lint-tools.git"
  },
  "bugs": {
    "url": "https://github.com/Hatkom-io/lint-tools/issues"
  },
  "homepage": "https://github.com/Hatkom-io/lint-tools#readme",
  "bin": {
    "lint-tools": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf ./dist tsconfig.tsbuildinfo && tsc",
    "bump": "bunx npm-check-updates -u --deep -p bun && bun i && bun update"
  },
  "keywords": [
    "lint",
    "dead-code",
    "graphql",
    "nestjs",
    "monorepo",
    "ts-morph"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@graphql-inspector/cli": "^7.0.0",
    "graphql": "^17.0.2",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@types/bun": "latest",
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2"
  }
}
